<dialog id="search-dialog" class="modal modal-top sm:modal-middle" aria-label="Search">
    <div class="modal-box mx-auto mt-0 w-full max-w-2xl p-4 sm:mt-0 sm:p-5">
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-base-content/70">Search the documentation</h2>
            <form method="dialog"><button class="btn btn-xs btn-ghost" aria-label="Close search">Esc</button></form>
        </div>
        <div id="search" class="max-h-[70vh] overflow-y-auto"></div>
        <p data-search-unavailable class="hidden py-6 text-center text-sm text-base-content/60">
            The search index hasn't been built yet. Run <code class="rounded bg-base-200 px-1.5 py-0.5">npm run build</code> to generate it.
        </p>
    </div>
    <form method="dialog" class="modal-backdrop"><button aria-label="Close search">close</button></form>
</dialog>

{%- set located = navigation | navLocate(page.url) %}
{%- if page.url != "/" %}
<div class="breadcrumbs mb-3 p-0 text-sm text-base-content/55">
    <ul>
        <li><a href="/" class="hover:text-primary">Home</a></li>
        {%- if located and located.section.title != "Getting started" %}
        <li>{% if located.section.url %}<a href="{{ located.section.url }}" class="hover:text-primary">{{ located.section.title }}</a>{% else %}{{ located.section.title }}{% endif %}</li>
        {%- elif tags and "guide" in tags %}
        <li><a href="/pages/articles/" class="hover:text-primary">Guides</a></li>
        {%- elif tags and "article" in tags %}
        <li><a href="/pages/articles/" class="hover:text-primary">Articles</a></li>
        {%- endif %}
    </ul>
</div>
{%- endif %}

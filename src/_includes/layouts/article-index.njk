{% extends "./doc.njk" %}

{% block aside %}{% endblock %}
{% block mainClass %}max-w-5xl{% endblock %}

{% block article %}
	{{ content | safe }}

	<h2 id="guides">Guides</h2>
	<p>Step-by-step walkthroughs for getting things done on Hex and related systems.</p>
	<div class="not-prose grid gap-4 sm:grid-cols-2">
	{% for post in collections.guide %}
		<a class="card-link flex flex-col gap-2" href="{{ post.url }}">
			<span class="font-semibold leading-snug text-base-content">{{ post.data.title }}</span>
			<span class="text-sm text-base-content/60">By {{ post.data.author }}</span>
			<span class="mt-auto flex flex-wrap gap-1.5 pt-2">
			{% for tag in post.data.tags | sort %}
				{% if tag != "guide" %}<span class="badge badge-sm badge-ghost font-mono">{{ tag }}</span>{% endif %}
			{% endfor %}
			</span>
		</a>
	{% endfor %}
	</div>

	<h2 id="articles">Articles</h2>
	<p>Background reading, comparisons and notes.</p>
	<div class="not-prose grid gap-4 sm:grid-cols-2">
	{% for post in collections.article %}
		<a class="card-link flex flex-col gap-2" href="{{ post.url }}">
			<span class="font-semibold leading-snug text-base-content">{{ post.data.title }}</span>
			<span class="text-sm text-base-content/60">By {{ post.data.author }}</span>
		</a>
	{% endfor %}
	</div>
{% endblock %}

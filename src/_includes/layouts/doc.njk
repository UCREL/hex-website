{% extends "./base.njk" %}

{#- Shared documentation page shell: breadcrumbs, title, content, prev/next and an 'On this page' column #}
{% block content %}
<div class="flex gap-12 px-4 py-8 sm:px-6 lg:px-10 lg:py-12">
	<main id="main" class="mx-auto min-w-0 max-w-3xl flex-1 {% block mainClass %}{% endblock %}" data-pagefind-body>
		{% include "partials/breadcrumbs.njk" %}

		<header class="mb-8">
			<h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{{ title }}</h1>
			{%- if author %}
			<p class="mt-3 flex flex-wrap items-center gap-x-2 text-sm text-base-content/60" data-pagefind-ignore>
				<span>By {{ author | safe }}</span>
				<span aria-hidden="true">·</span>
				<span>{{ content | readingTime }} min read</span>
			</p>
			{%- endif %}
		</header>

		{% block notice %}{% endblock %}

		<article class="prose {% block proseClass %}prose-base sm:prose-lg{% endblock %}">
			{% block article %}{{ content | safe }}{% endblock %}
		</article>

		{% include "partials/pageflow.njk" %}

		<div class="mt-12 flex justify-end border-t border-base-300 pt-6 text-sm" data-pagefind-ignore>
			<a href="https://github.com/UCREL/hex-website/edit/main/{{ page.inputPath | replace('./', '') }}" class="inline-flex items-center gap-1.5 text-base-content/55 hover:text-primary" target="_blank" rel="noopener">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
				Edit this page on GitHub
			</a>
		</div>
	</main>

	{% block aside %}{% include "partials/toc.njk" %}{% endblock %}
</div>
{% endblock %}
